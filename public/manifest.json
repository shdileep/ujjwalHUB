{
    "id": "com.ujjwalhub.app",
    "name": "Ujjwal Hub - Waste Management",
    "short_name": "UjjwalHub",
    "description": "Premium Municipal Waste Management and Fleet Platform",
    "background_color": "#ffffff",
    "theme_color": "#4f46e5",
    "start_url": "/",
    "scope": "/",
    "lang": "en",
    "display": "standalone",
    "orientation": "portrait",
    "categories": [
        "productivity",
        "utilities",
        "business"
    ],
    "dir": "ltr",
    "prefer_related_applications": false,
    "related_applications": [],
    "iarc_rating_id": "none",
    "display_override": [
        "standalone",
        "window-controls-overlay",
        "minimal-ui"
    ],
    "icons": [
        {
            "src": "pwa_icon_192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "pwa_icon_192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "pwa_icon_512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "pwa_icon_512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
        {
            "src": "screenshot1.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Dashboard"
        },
        {
            "src": "screenshot2.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Driver View"
        },
        {
            "src": "screenshot_desktop.png",
            "sizes": "1920x1080",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Desktop Overview"
        }
    ],
    "shortcuts": [
        {
            "name": "Dashboard",
            "short_name": "Dashboard",
            "url": "/",
            "icons": [
                {
                    "src": "pwa_icon_192.png",
                    "sizes": "192x192"
                }
            ]
        }
    ],
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "text/csv": [
                    ".csv"
                ]
            }
        }
    ],
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "note_taking": {
        "new_note_url": "/"
    },
    "protocol_handlers": [
        {
            "protocol": "web+ujjwal",
            "url": "/?url=%s"
        }
    ],
    "share_target": {
        "action": "/",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "widgets": [],
    "edge_side_panel": {
        "preferred_width": 400
    },
    "scope_extensions": [
        {
            "origin": "*.pages.dev"
        }
    ]
}